# Copy to .env and fill in. All values below are defaults from app/config.py
# unless marked (required).

# Always SQLite, in every environment — dev and production alike.
# In docker-compose this is overridden to point at the mounted volume; see docker-compose.yml.
DATABASE_URL=sqlite:///./engrow.db
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=60

# Must exactly match the frontend origin actually serving the app (scheme + host + port).
# A mismatch here is the #1 cause of "CORS error" / silent fetch failures in the browser.
FRONTEND_ORIGIN=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@engrow.app

BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=6

SUPERADMIN_EMAIL=admin@engrow.app
SUPERADMIN_PASSWORD=change-me-now
ADMIN_SECRET_KEY=admin-secret-change-me

# Google Sign-In. Leave empty to disable (POST /auth/google will 401 on every call).
GOOGLE_CLIENT_ID=

# Web Push. Generate with: python scripts/generate_vapid_keys.py
VAPID_PRIVATE_KEY_PATH=./vapid_private_key.pem
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=admin@engrow.app
